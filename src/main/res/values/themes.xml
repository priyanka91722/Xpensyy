<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Xpensy" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondaryContainer">@color/brand_primary_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="materialButtonStyle">@style/Widget.Xpensy.Button</item>
    </style>

    <style name="Widget.Xpensy.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Xpensy.SecondaryButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/brand_primary_dark</item>
        <item name="iconTint">@color/brand_primary_dark</item>
    </style>

    <style name="Widget.Xpensy.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">@color/card_stroke</item>
    </style>
</resources>
